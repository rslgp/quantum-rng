    {
      "parameters": {
        "jsCode": "const vacuumquantum = $input.first().json;\n\n// Function to get an emoji based on the result text\nconst getEmoji = (text) => {\n  if(text.scale == 0) return \"⚪\";\n  if(text.scale > 0) return \"🟢\"\n  else return \"🔴\";\n};\n\n// Function to generate the progress bar with a limit of 10 slots\nconst generateProgressBar = (value) => {\n  const slots = Math.round(value / 10); // Each slot represents 10%\n  return \"🟩\".repeat(slots) + \"⬜\".repeat(10 - slots); // Use █ for filled and ░ for empty\n};\n\nlet conclusao = `\\n\\n${vacuumquantum.majorityResult.replace(\":\",\" final:\")}\\n\\n`\n// Generate the Telegram message\nlet telegramMessage = '';\nlet quantumResult = [];\nvacuumquantum.result.forEach((result) => {\n  const emoji = getEmoji(result.text);\n  const progressBar = generateProgressBar(result.value);\n  quantumResult.push(`${emoji} ${result.text.value} (${result.value}%)\\n${progressBar}`);\n});\ntelegramMessage = quantumResult.join(\"\\n\\n\")+conclusao;\nreturn [{telegramMessage}];"
      },

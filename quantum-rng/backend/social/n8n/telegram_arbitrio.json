      "parameters": {
        "jsCode": "const {body} = $input.first().json;\nconst telegramMessage = `aguarde ${body.missingTime || \"8 horas\"} ou acesse arbitrio.mapafome.com.br/user/setup_chat?telegram=${$('doDecision').first().json.message.chat.id}\\npara criar sua conta`;\nreturn [{telegramMessage}];"
